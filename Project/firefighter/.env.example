# =============================================
# 프론트엔드 환경 변수 템플릿 (.env.example)
# =============================================
# 이 파일을 복사하여 .env.local 파일을 생성한 뒤, 실제 값으로 채워주세요.
# 변수 이름은 반드시 REACT_APP_ 으로 시작해야 합니다.
# 이 파일은 Git에 포함되어야 합니다.

# --- Firebase Client SDK 설정 (Firestore용) ---
REACT_APP_FS_API_KEY=
REACT_APP_FS_AUTH_DOMAIN=
REACT_APP_FS_PROJECT_ID=
REACT_APP_FS_STORAGE_BUCKET=
REACT_APP_FS_MESSAGING_SENDER_ID=
REACT_APP_FS_APP_ID=
REACT_APP_FS_MEASUREMENT_ID=

# --- Firebase Client SDK 설정 (Realtime DB용) ---
REACT_APP_RT_API_KEY=
REACT_APP_RT_AUTH_DOMAIN=
REACT_APP_RT_DATABASE_URL=
REACT_APP_RT_PROJECT_ID=
REACT_APP_RT_STORAGE_BUCKET=
REACT_APP_RT_MESSAGING_SENDER_ID=
REACT_APP_RT_APP_ID=
REACT_APP_RT_MEASUREMENT_ID=

# --- VWorld 지도 API 키 ---
REACT_APP_VWORLD_API_KEY=
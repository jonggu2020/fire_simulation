# =========================================
# 백엔드 서버 환경 변수 템플릿 (.env.example)
# =========================================
# 이 파일을 복사하여 .env 파일을 생성한 뒤, 실제 값으로 채워주세요.
# 이 파일은 Git에 포함되어야 합니다.

# --- MySQL 데이터베이스 연결 정보 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER= # <-- 여기에 실제 DB 사용자 이름을 입력하세요. (예: root)
DB_PASSWORD= # <-- 여기에 실제 DB 비밀번호를 입력하세요.
DB_NAME= # <-- 여기에 실제 DB 이름을 입력하세요. (예: fire)

# --- Firebase Admin SDK 설정 ---
# Firebase 콘솔에서 다운로드한 서비스 계정 키(.json) 파일의 "전체 내용"을
# 한 줄의 문자열로 변환하여 붙여넣으세요.
FIRESTORE_SERVICE_ACCOUNT_JSON=
RTDB_SERVICE_ACCOUNT_JSON=

# Firebase Realtime Database URL
# Firebase 콘솔 > Realtime Database > 데이터 탭에서 확인 가능합니다.
FIREBASE_DATABASE_URL= # <-- 여기에 실제 RTDB URL을 입력하세요. (예: https://your-project-id.firebaseio.com)

# --- Python 예측 서버 URL ---
# 기본값은 로컬호스트입니다. 필요시 변경하세요.
PREDICTION_SERVER_URL=http://127.0.0.1:5000